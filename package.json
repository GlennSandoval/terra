{
  "name": "terra",
  "version": "1.5.2-beta",
  "packageManager": "bun@1.3.14",
  "description": "A JavaScript library for simple biological simulations and cellular automata.",
  "main": "dist/terra.min.js",
  "scripts": {
    "prebuild": "mkdir -p dist",
    "build": "rollup --config && terser dist/terra.js --compress --mangle --output dist/terra.min.js",
    "prepack": "bun run build",
    "test": "bun run build && bun test ./tests/test.js"
  },
  "keywords": [
    "terrarium",
    "simulator",
    "cellular",
    "automata"
  ],
  "author": "rileyjshaw <i@rileyjshaw.com>",
  "license": "MIT",
  "devDependencies": {
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-typescript": "^12.3.0",
    "rollup": "^4.64.3",
    "terser": "^5.51.2",
    "tslib": "^2.8.1",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "lodash": "~2.4.1",
    "seedrandom": "^3.0.5"
  }
}
