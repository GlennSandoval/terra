{
  "name": "terra",
  "version": "1.5.2-beta",
  "description": "A JavaScript library for simple biological simulations and cellular automata.",
  "main": "dist/terra.min.js",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "prebuild": "node -e \"require('node:fs').mkdirSync('dist', {recursive: true})\"",
    "build": "rollup --config && terser dist/terra.js --compress --mangle --output dist/terra.min.js",
    "prepack": "npm run build",
    "test": "npm run build && node --test tests/test.js"
  },
  "keywords": [
    "terrarium",
    "simulator",
    "cellular",
    "automata"
  ],
  "author": "rileyjshaw <i@rileyjshaw.com>",
  "license": "MIT",
  "devDependencies": {
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "rollup": "^4.64.3",
    "terser": "^5.51.2"
  },
  "dependencies": {
    "lodash": "~2.4.1",
    "seedrandom": "^3.0.5"
  }
}
