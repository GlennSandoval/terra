{
  "name": "terra",
  "version": "1.5.2-beta",
  "packageManager": "bun@1.3.14",
  "description": "A JavaScript library for simple biological simulations and cellular automata.",
  "main": "dist/terra.min.js",
  "types": "dist/terra.d.ts",
  "scripts": {
    "prebuild": "mkdir -p dist",
    "build": "rm -f dist/*.d.ts && tsc -p tsconfig.build.json && rollup --config && rm -rf dist/.types && terser dist/terra.js --compress --mangle --output dist/terra.min.js",
    "prepack": "bun run build",
    "check": "biome check .",
    "format": "biome format --write .",
    "typecheck": "tsc --noEmit",
    "test": "bun test app && bun run typecheck",
    "test:smoke": "bun run build && bun test ./tests/test.ts"
  },
  "keywords": [
    "terrarium",
    "simulator",
    "cellular",
    "automata"
  ],
  "author": "rileyjshaw <i@rileyjshaw.com>",
  "license": "MIT",
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-typescript": "^12.3.0",
    "bun-types": "1.3.14",
    "rollup": "^4.64.3",
    "rollup-plugin-dts": "^6.5.1",
    "terser": "^5.51.2",
    "tslib": "^2.8.1",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "seedrandom": "^3.0.5"
  }
}
